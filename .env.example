# Application Configuration
APP_NAME=service-product-purchase
APP_VERSION=1.0.0
ENVIRONMENT=development

# HTTP Server
HTTP_PORT=8001

# Database Configuration
POSTGRESQL_URL=postgresql://tutuplapak_user:tutuplapak_password@host.docker.internal:5432/tutuplapak_db?sslmode=disable
CIPHER_POSTGRESQL=tutuplapak_password

# Logging
LOG_LEVEL=debug

# JWT Configuration - CHANGE THIS IN PRODUCTION!
JWT_SECRET=your-secure-jwt-secret-change-this-in-production

# Timezone
TZ=Asia/Jakarta