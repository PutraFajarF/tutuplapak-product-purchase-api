    },
    "version": "1.0"
  },
  "host": "localhost:8001",
  "basePath": "/api/v1",
  "schemes": ["http"],
  "consumes": ["application/json"],
  "produces": ["application/json"],
  "securityDefinitions": {
    "Bearer": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header",
      "description": "Type \"Bearer\" followed by a space and JWT token."
    }
  },
  "paths": {
    "/product": {
      "post": {
        "summary": "Create a new product",
        "description": "Create a new product with the provided details",
        "tags": ["products"],
        "security": [{"Bearer": []}],
        "parameters": [
          {
            "in": "body",
            "name": "request",
            "description": "Product creation request",
            "required": true,
            "schema": {
              "$ref": "#/definitions/product.CreateProductRequest"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created",
            "schema": {
              "$ref": "#/definitions/product.CreateProdutResponse"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "409": {
            "description": "Conflict",
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        }
      },
      "get": {
        "summary": "Get list of products",
        "description": "Get a paginated list of products with optional filters",
        "tags": ["products"],
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "description": "Limit",
            "type": "integer",
            "default": 5
          },
          {
            "in": "query",
            "name": "offset",
            "description": "Offset",
            "type": "integer",
            "default": 0
          },
          {
            "in": "query",
            "name": "productId",
            "description": "Product ID",
            "type": "string"
          },
          {
            "in": "query",
            "name": "sku",
            "description": "SKU",
            "type": "string"
          },
          {
            "in": "query",
            "name": "category",
            "description": "Category",
            "type": "string"
          },
          {
            "in": "query",
            "name": "sortBy",
            "description": "Sort by",
            "type": "string",
            "enum": ["newest", "oldest", "cheapest", "expensive"]
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/product.ProdutListResponse"
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "/product/{productId}": {
      "put": {
        "summary": "Update an existing product",
        "description": "Update a product with the provided details",
        "tags": ["products"],
        "security": [{"Bearer": []}],
        "parameters": [
          {
            "in": "path",
            "name": "productId",
            "description": "Product ID",
            "required": true,
            "type": "string"
          },
          {
            "in": "body",
            "name": "request",
            "description": "Product update request",
            "required": true,
            "schema": {
              "$ref": "#/definitions/product.UpdateProductRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/product.UpdateProdutResponse"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "409": {
            "description": "Conflict",
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete a product",
        "description": "Delete a product by its ID",
        "tags": ["products"],
        "security": [{"Bearer": []}],
        "parameters": [
          {
            "in": "path",
            "name": "productId",
            "description": "Product ID",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "/purchase": {
      "post": {
        "summary": "Create a purchase",
        "description": "Create a new purchase with items and sender details",
        "tags": ["purchases"],
        "parameters": [
          {
            "in": "body",
            "name": "request",
            "description": "Purchase creation request",
            "required": true,
            "schema": {
              "$ref": "#/definitions/purchase.CreatePurchaseReq"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created",
            "schema": {
              "$ref": "#/definitions/purchase.CreatePurchaseResp"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      }
    },
    "/purchase/{purchaseId}": {
      "post": {
        "summary": "Upload payment proof for a purchase",
        "description": "Upload proof of payment files for an existing purchase",
        "tags": ["purchases"],
        "parameters": [
          {
            "in": "path",
            "name": "purchaseId",
            "description": "Purchase ID",
            "required": true,
            "type": "string"
          },
          {
            "in": "body",
            "name": "request",
            "description": "Upload proof request",
            "required": true,
            "schema": {
              "$ref": "#/definitions/purchase.UploadProofReq"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      }
    }
  },
  "definitions": {
    "product.CreateProductRequest": {
      "type": "object",
      "required": ["name", "category", "qty", "price", "sku", "fileId"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 4,
          "maxLength": 32
        },
        "category": {
          "type": "string",
          "enum": ["Food", "Beverage", "Clothes", "Furniture", "Tools"]
        },
        "qty": {
          "type": "integer",
          "minimum": 1
        },
        "price": {
          "type": "integer",
          "minimum": 100
        },
        "sku": {
          "type": "string",
          "maxLength": 32
        },
        "fileId": {
          "type": "string"
        }
      }
    },
    "product.CreateProdutResponse": {
      "type": "object",
      "properties": {
        "productId": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "qty": {
          "type": "integer"
        },
        "price": {
          "type": "integer"
        },
        "sku": {
          "type": "string"
        },
        "fileId": {
          "type": "string"
        },
        "fileUri": {
          "type": "string"
        },
        "fileThumbnailUri": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      }
    },
    "product.UpdateProductRequest": {
      "type": "object",
      "required": ["productId", "name", "category", "qty", "price", "sku", "fileId"],
      "properties": {
        "productId": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "minLength": 4,
          "maxLength": 32
        },
        "category": {
          "type": "string",
          "enum": ["Food", "Beverage", "Clothes", "Furniture", "Tools"]
        },
        "qty": {
          "type": "integer",
          "minimum": 1
        },
        "price": {
          "type": "integer",
          "minimum": 100
        },
        "sku": {
          "type": "string",
          "maxLength": 32
        },
        "fileId": {
          "type": "string"
        }
      }
    },
    "product.UpdateProdutResponse": {
      "type": "object",
      "properties": {
        "productId": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "qty": {
          "type": "integer"
        },
        "price": {
          "type": "integer"
        },
        "sku": {
          "type": "string"
        },
        "fileId": {
          "type": "string"
        },
        "fileUri": {
          "type": "string"
        },
        "fileThumbnailUri": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      }
    },
    "product.ProdutListResponse": {
      "type": "object",
      "properties": {
        "productId": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "qty": {
          "type": "integer"
        },
        "price": {
          "type": "integer"
        },
        "sku": {
          "type": "string"
        },
        "fileId": {
          "type": "string"
        },
        "fileUri": {
          "type": "string"
        },
        "fileThumbnailUri": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      }
    },
    "purchase.CreatePurchaseReq": {
      "type": "object",
      "required": ["purchasedItems", "senderName", "senderContactType", "senderContactDetail"],
      "properties": {
        "purchasedItems": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/purchase.CreatePurchaseItemReq"
          }
        },
        "senderName": {
          "type": "string",
          "minLength": 4,
          "maxLength": 55
        },
        "senderContactType": {
          "type": "string",
          "enum": ["email", "phone"]
        },
        "senderContactDetail": {
          "type": "string"
        }
      }
    },
    "purchase.CreatePurchaseItemReq": {
      "type": "object",
      "required": ["productId", "qty"],
      "properties": {
        "productId": {
          "type": "string"
        },
        "qty": {
          "type": "integer",
          "minimum": 2
        }
      }
    },
    "purchase.CreatePurchaseResp": {
      "type": "object",
      "properties": {
        "purchaseId": {
          "type": "string"
        },
        "purchasedItems": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/purchase.ProductSnapshotResp"
          }
        },
        "totalPrice": {
          "type": "integer",
          "format": "int64"
        },
        "paymentDetails": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/purchase.PaymentDetailResp"
          }
        }
      }
    },
    "purchase.ProductSnapshotResp": {
      "type": "object",
      "properties": {
        "productId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "qty": {
          "type": "integer"
        },
        "price": {
          "type": "integer",
          "format": "int64"
        },
        "sku": {
          "type": "string"
        },
        "fileId": {
          "type": "string"
        },
        "fileUri": {
          "type": "string"
        },
        "fileThumbnailUri": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "purchase.PaymentDetailResp": {
      "type": "object",
      "properties": {
        "bankAccountName": {
          "type": "string"
        },
        "bankAccountHolder": {
          "type": "string"
        },
        "bankAccountNumber": {
          "type": "string"
        },
        "totalPrice": {
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "purchase.UploadProofReq": {
      "type": "object",
      "required": ["fileIds"],
      "properties": {
        "fileIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
